# ============================================================================
# Makefile.config - Configuration for different build types
# ============================================================================

# Build configurations
CONFIG ?= release

# Release build (default)
ifeq ($(CONFIG),release)
    CXXFLAGS += -O3 -DNDEBUG -march=native
    LDFLAGS += -s
endif

# Debug build
ifeq ($(CONFIG),debug)
    CXXFLAGS += -g -O0 -DDEBUG -D_GLIBCXX_DEBUG
    LDFLAGS += -g
endif

# Sanitizer builds
ifeq ($(CONFIG),asan)
    CXXFLAGS += -g -O0 -fsanitize=address -fno-omit-frame-pointer -DDEBUG
    LDFLAGS += -fsanitize=address
    export ASAN_OPTIONS=detect_leaks=1
endif

ifeq ($(CONFIG),tsan)
    CXXFLAGS += -g -O0 -fsanitize=thread -DDEBUG
    LDFLAGS += -fsanitize=thread
endif

ifeq ($(CONFIG),ubsan)
    CXXFLAGS += -g -O0 -fsanitize=undefined -DDEBUG
    LDFLAGS += -fsanitize=undefined
endif

# Coverage build
ifeq ($(CONFIG),coverage)
    CXXFLAGS += -g -O0 --coverage -DDEBUG
    LDFLAGS += --coverage
endif

# Profile guided optimization
ifeq ($(CONFIG),pgo)
    CXXFLAGS += -O3 -march=native -fprofile-generate
    LDFLAGS += -fprofile-generate
endif

# Print configuration
print-config:
	@echo "Configuration: $(CONFIG)"
	@echo "CXX: $(CXX)"
	@echo "CXXFLAGS: $(CXXFLAGS)"
	@echo "LDFLAGS: $(LDFLAGS)"